NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rekap_tekad
DB_USER=root
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Opsional: socket XAMPP jika koneksi TCP tidak digunakan
DB_SOCKET=
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Opsional: path executable kompresi PDF (default: gs pada PATH)
GHOSTSCRIPT_PATH=

# Folder privat untuk lampiran, relatif terhadap backend atau path absolut
STORAGE_DIR=storage/uploads
